{
  "name": "pdf-studio",
  "productName": "PDF Studio",
  "version": "1.0.14",
  "description": "أدوات PDF عربية — تطبيق سطح مكتب",
  "homepage": "https://github.com/AHKH3/pdf-studio",
  "author": "abdo3342",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.cjs && node assets/js/tools/protect/copy-qpdf.mjs && node assets/js/tools/ocr/copy-runtime.mjs && node scripts/copy-upscaler.cjs",
    "vendor": "node scripts/copy-vendor.cjs",
    "vendor:upscaler": "node scripts/copy-upscaler.cjs",
    "vendor:qpdf": "node assets/js/tools/protect/copy-qpdf.mjs",
    "vendor:ocr": "node assets/js/tools/ocr/copy-runtime.mjs",
    "icons": "node scripts/generate-icon-sprite.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node scripts/check-syntax.mjs && node scripts/test-scan.mjs && node scripts/test-experience.mjs && node scripts/test-tools.mjs && node scripts/test-edit.mjs && node scripts/test-protect.mjs && node scripts/test-launch.mjs && node scripts/test-electron-shell.mjs && node scripts/test-publish.mjs",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@tensorflow/tfjs": "~4.11.0",
    "@tensorflow/tfjs-backend-wasm": "~4.11.0",
    "@upscalerjs/esrgan-slim": "^1.0.0",
    "electron-updater": "^6.8.9",
    "heic2any": "^0.0.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "qpdf-wasm": "^0.1.0",
    "sortablejs": "1.15.7",
    "tesseract.js": "^7.0.0",
    "upscaler": "^1.0.0"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.pdfstudio.desktop",
    "publish": {
      "provider": "github",
      "owner": "AHKH3",
      "repo": "pdf-studio",
      "releaseType": "release"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "assets/branding/app-icon-512.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/branding/app-icon-512.png",
      "signAndEditExecutable": false,
      "publisherName": "AHKH3",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "artifactName": "PDFStudio-Setup.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "PDFStudio-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "maintainer": "abdo3342",
      "icon": "assets/branding/app-icon-512.png",
      "artifactName": "PDFStudio.${ext}"
    }
  }
}
