{
  "name": "pdf-studio",
  "productName": "PDF Studio",
  "version": "1.0.17",
  "description": "أدوات PDF عربية — تطبيق سطح مكتب",
  "homepage": "https://github.com/AHKH3/pdf-studio",
  "author": "abdo3342",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.cjs && node scripts/copy-upscaler.cjs",
    "vendor": "node scripts/copy-vendor.cjs",
    "vendor:upscaler": "node scripts/copy-upscaler.cjs",
    "icons": "node scripts/generate-icon-sprite.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node scripts/check-syntax.mjs && node scripts/test-scan.mjs && node scripts/test-experience.mjs && node scripts/test-tools.mjs && node scripts/test-edit.mjs && node scripts/test-launch.mjs && node scripts/test-electron-shell.mjs && node scripts/test-publish.mjs && node scripts/test-toolprefs.mjs",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@tensorflow/tfjs": "~4.11.0",
    "@tensorflow/tfjs-backend-wasm": "~4.11.0",
    "@upscalerjs/esrgan-slim": "^1.0.0",
    "electron-updater": "^6.8.9",
    "heic2any": "^0.0.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "sortablejs": "1.15.7",
    "upscaler": "^1.0.0"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "app.pdfstudio.desktop",
    "publish": {
      "provider": "github",
      "owner": "AHKH3",
      "repo": "pdf-studio",
      "releaseType": "release"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "assets/**/*",
      "build/icon.ico"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/apply-exe-icon.cjs",
    "icon": "build/icon.ico",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "publisherName": "AHKH3",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "artifactName": "PDFStudio-Setup.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
